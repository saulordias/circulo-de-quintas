# Regras de cache para Netlify e Cloudflare Pages.
# Os arquivos que definem a versão do app nunca ficam em cache, para a atualização chegar ao celular.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
/assets/*
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=86400
